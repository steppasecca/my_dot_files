// -*- mode: jsonc -*-
{
    "height": 30,
    "css_file": "/home/steppasecca/.config/waybar/style.css",
    "spacing": 4,
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/window"
    ],
    "modules-right": [
        "custom/monitor2",
        "custom/monitor3",
        "pulseaudio",
		"sway/language",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "clock",
        "tray",
		"custom/power"
    ],
	"sway/workspaces": {
        "persistent_workspaces": {
            "1": [], // Workspace 1 sempre visibile
            "2": [], // Workspace 2 sempre visibile
            "3": [], // Workspace 3 sempre visibile
            "4": [], // Workspace 4 sempre visibile
            "5": []  // E così via per i workspace che vuoi sempre vedere
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

	"sway/language": {
		"format": "<span>{short}</span>", 
		"tooltip": true,
		"on-click": "swaymsg input type:keyboard xkb_switch_layout next"
	},
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% <span font_size='x-large'></span>",
        "tooltip": false
    },
	"memory": { "format": "{percentage}% <span font_size='x-large'></span>",
	"format-alt": "{used:0.1f}GB <span font_size='x-large'></span>",
	"on-click": "waybar-msg module memory format alt",
	"tooltip": false
	},
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C <span font_size='x-large'>{icon}</span>",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        "format": "{percent}% <span font_size='x-large'>{icon}</span>",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% <span font_size='x-large'>{icon}</span>",
        "format-full": "{capacity}% <span font_size='x-large'>{icon}</span>",
        "format-charging": "{capacity}% <span font_size='x-large'></span>",
        "format-plugged": "{capacity}% <span font_size='x-large'></span>",
        "format-alt": "{time} <span font_size='x-large'>{icon}</span>",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) <span font_size='x-large'></span>",
        "format-ethernet": "{ipaddr}/{cidr} <span font_size='x-large'></span>",
        "tooltip-format": "{ifname} via {gwaddr} <span font_size='x-large'></span>",
        "format-linked": "{ifname} (No IP) <span font_size='x-large'></span>",
        "format-disconnected": "Disconnected <span font_size='x-large'>⚠</span>",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{volume}% <span font_size='x-large'>{icon}</span> {format_source}",
        "format-bluetooth": "{volume}% <span font_size='x-large'>{icon}</span><span font_size='x-large'></span> {format_source}",
        "format-bluetooth-muted": "<span font_size='x-large'></span> <span font_size='x-large'>{icon}</span><span font_size='x-large'></span> {format_source}",
        "format-muted": "<span font_size='x-large'></span> {format_source}",
        "format-source": "{volume}% <span font_size='x-large'></span>",
        "format-source-muted": "<span font_size='x-large'></span>",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
	"custom/power": {
    "format": "⏻",
    "tooltip": "Menu alimentazione",
    "on-click": "~/.config/waybar/scripts/power-menu.sh",
    "interval": 0
	},

"custom/monitor2": {
    "exec": "$HOME/.config/waybar/monitor_toggle.sh DP-3",
    "return-type": "json",
    "interval": 2,
    "on-click": "swaymsg exec 'sh -c \"sleep 0.2 && swaymsg output DP-3 toggle\"'"
},

"custom/monitor3": {
    "exec": "$HOME/.config/waybar/monitor_toggle.sh DP-4",
    "return-type": "json",
    "interval": 2,
    "on-click": "swaymsg exec 'sh -c \"sleep 0.2 && swaymsg output DP-4 toggle\"'"
}

}
