{
    "height": 30,
    "spacing": 0,
    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-right": [
        "custom/monitor2",
        "custom/monitor3",
        "pulseaudio",
        "sway/language",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "sway/mode": {
        "format": "{}"
    },
    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },
    "sway/language": {
        "format": "{short}",
        "tooltip": true,
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "\uf2db {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "\uf538 {percentage}%",
        "format-alt": "\uf538 {used:0.1f}G",
        "tooltip": false
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["\uf2cb", "\uf2c9", "\uf2c7"]
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["\uf186", "\uf185"]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]
    },
    "network": {
        "format-wifi": "\uf1eb {essid} {signalStrength}%",
        "format-ethernet": "\uf0e8 {ipaddr}",
        "format-linked": "\uf127 {ifname}",
        "format-disconnected": "\uf071 offline",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%{format_source}",
        "format-bluetooth": "{icon}\uf293 {volume}%{format_source}",
        "format-muted": "\uf6a9{format_source}",
        "format-source": "",
        "format-source-muted": " \uf131",
        "format-icons": {
            "headphone": "\uf025",
            "hands-free": "\uf025",
            "headset": "\uf025",
            "phone": "\uf095",
            "portable": "\uf10b",
            "car": "\uf1b9",
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },
    "custom/monitor2": {
        "exec": "$HOME/.config/waybar/monitor_toggle.sh DP-3",
        "return-type": "json",
        "interval": 2,
        "on-click": "swaymsg exec 'sh -c \"sleep 0.2 && swaymsg output DP-3 toggle\"'"
    },
    "custom/monitor3": {
        "exec": "$HOME/.config/waybar/monitor_toggle.sh DP-4",
        "return-type": "json",
        "interval": 2,
        "on-click": "swaymsg exec 'sh -c \"sleep 0.2 && swaymsg output DP-4 toggle\"'"
    }
}
