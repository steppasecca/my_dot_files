/*
 * ========================================
 * IMPOSTAZIONI GLOBALI PER WAYBAR
 * ========================================
 */
* {
    /*
     * ESSENZIALE: Imposta il tuo Nerd Font come prima opzione
     * Waybar cercherà in questa lista di font i glifi (icone).
     * Se l'icona non è nel primo font, passa al successivo.
     * Mantenere 'monospace' come fallback è una buona pratica.
     */
	font-family: "JetBrainsMono Nerd Font Mono", monospace; 
    font-size: 13px;
}

/* * ========================================
 * IMPOSTAZIONI BASE DELLA BARRA (OPZIONALI)
 * ========================================
 */
#waybar {
    background-color: rgba(46, 52, 64, 0.9); /* Un colore scuro semi-trasparente */
    color: #eceff4;                           /* Colore del testo chiaro */
    border-bottom: 3px solid #88c0d0;         /* Linea di fondo sottile (opzionale) */
}

/* * ========================================
 * ESEMPIO DI STILE DEL MODULO BATTERY
 * ========================================
 */
#battery {
    background-color: #5e81ac; /* Colore di sfondo per il modulo batteria */
    color: #ffffff;
    padding-left: 10px;
    padding-right: 10px;
}

/* Stile per stato Critical (Sotto il 15%) */
#battery.critical {
    background-color: #bf616a; /* Rosso */
}

/* Stile per stato Charging (In carica) */
#battery.charging {
    background-color: #a3be8c; /* Verde */
}

/* * ========================================
 * ESEMPIO DI STILE DEL MODULO CLOCK
 * ========================================
 */
#clock {
    padding: 0 10px;
    background-color: #4c566a;
}

/* Puoi aggiungere stili per tutti gli altri moduli come #cpu, #network, ecc. */
